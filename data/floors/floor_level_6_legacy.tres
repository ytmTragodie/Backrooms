[gd_resource type="Resource" script_class="FloorData" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/floors/floor_data.gd" id="1_floor"]
[ext_resource type="Script" path="res://scripts/events/event_data.gd" id="2_event"]
[ext_resource type="Resource" path="res://data/events/event_level6_dark_corridor.tres" id="3_dark"]
