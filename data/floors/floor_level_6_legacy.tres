[resource]
script = ExtResource("1_floor")
id = &"floor_level_6"
display_name = "六层：黑暗"
fresh_events = Array[ExtResource("2_event")]([ExtResource("3_dark"), ExtResource("4_seam"), ExtResource("5_marks")])
