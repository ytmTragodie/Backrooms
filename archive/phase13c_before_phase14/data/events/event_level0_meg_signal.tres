[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://scripts/events/event_data.gd" id="script"]
[ext_resource type="Resource" path="res://data/insights/insight_level0_meg_signal.tres" id="insight"]
[ext_resource type="Resource" path="res://data/rewards/reward_cards.tres" id="reward"]

[resource]
script = ExtResource("script")
id = &"event_level0_meg_signal"
display_name = "M.E.G. 断续信号"
display_text = "四回合内打出两张搜索标签牌，可接通联络并获得一次牌奖励。"
category = 2
duration = 4
condition_tag = &"SEARCH"
required_actions = 2
supply_reward = 1
insight = ExtResource("insight")
card_reward = ExtResource("reward")
