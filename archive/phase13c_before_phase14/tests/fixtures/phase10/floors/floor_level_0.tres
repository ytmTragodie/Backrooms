[gd_resource type="Resource" script_class="FloorData" format=3]

[ext_resource type="Script" path="res://scripts/floors/floor_data.gd" id="script"]
[ext_resource type="Script" path="res://scripts/objectives/objective_data.gd" id="event_type"]
[ext_resource type="Script" path="res://scripts/floors/resource_node_data.gd" id="node_type"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/safe_points/safe_level0.tres" id="safe"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/floors/floor_level_6.tres" id="destination"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/events/event_level0_humming.tres" id="e0"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/events/event_level0_wall_marks.tres" id="e1"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/events/event_level0_wrong_corner.tres" id="e2"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/events/event_level0_damp_wall.tres" id="e3"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/events/event_level0_meg_signal.tres" id="e4"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/resources/resource_level0_supply.tres" id="n0"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/resources/resource_level0_battery.tres" id="n1"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/resources/resource_level0_scrap.tres" id="n2"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/resources/resource_level0_water.tres" id="n3"]

[resource]
script = ExtResource("script")
id = &"floor_level_0"
display_name = "零层"
card_first_exploration = true
retire_resolved_objectives = true
objective_spawn_chance = 1.0
max_objectives_per_floor = 5
intro_objective = ExtResource("e0")
fresh_objectives = Array[ExtResource("event_type")]([ExtResource("e0"), ExtResource("e1"), ExtResource("e2"), ExtResource("e3"), ExtResource("e4")])
resource_nodes = Array[ExtResource("node_type")]([ExtResource("n0"), ExtResource("n1"), ExtResource("n2"), ExtResource("n3")])
safe_point = ExtResource("safe")
cutout_destinations = Array[Resource]([ExtResource("destination")])
minimum_exit_turn = 3
minimum_exit_explore = 6
fallback_exit_turn = 6
overstay_start_turn = 6
overstay_interval = 3
