[gd_resource type="Resource" script_class="FloorData" format=3]

[ext_resource type="Script" path="res://scripts/floors/floor_data.gd" id="script"]
[ext_resource type="Script" path="res://scripts/objectives/objective_data.gd" id="event_type"]
[ext_resource type="Script" path="res://scripts/floors/resource_node_data.gd" id="node_type"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/safe_points/safe_level6.tres" id="safe"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/floors/floor_phase6_exit.tres" id="destination"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/events/event_level6_unstable_corridor.tres" id="e0"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/events/event_level6_dark_corridor.tres" id="e1"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/events/event_level6_claw_marks.tres" id="e2"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/events/event_level6_wall_seam.tres" id="e3"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/events/event_level6_emergency_light.tres" id="e4"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/resources/resource_level6_battery.tres" id="n0"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/resources/resource_level6_crowbar.tres" id="n1"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/resources/resource_level6_water.tres" id="n2"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/entities/entity_hound.tres" id="hound"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/entities/entity_smiler.tres" id="smiler"]
[ext_resource type="Resource" path="res://tests/fixtures/phase10/insights/insight_level6_light_attracts.tres" id="light_insight"]

[resource]
script = ExtResource("script")
id = &"floor_level_6"
display_name = "六层"
card_first_exploration = true
retire_resolved_objectives = true
objective_spawn_chance = 1.0
max_objectives_per_floor = 5
intro_objective = ExtResource("e0")
fresh_objectives = Array[ExtResource("event_type")]([ExtResource("e0"), ExtResource("e1"), ExtResource("e2"), ExtResource("e3"), ExtResource("e4")])
resource_nodes = Array[ExtResource("node_type")]([ExtResource("n0"), ExtResource("n1"), ExtResource("n2")])
safe_point = ExtResource("safe")
cutout_destinations = Array[Resource]([ExtResource("destination")])
minimum_exit_turn = 3
minimum_exit_explore = 6
fallback_exit_turn = 6
overstay_start_turn = 4
overstay_interval = 2
entry_entity = ExtResource("hound")
followup_entity = ExtResource("smiler")
landmark_insight = ExtResource("light_insight")
followup_on_light = true
initial_flags = Array[StringName]([&"darkness"])
dark_observe_surcharge = 1
threat_damage_step = 4
